{
  "manifest_version": 3,
  "name": "巴别塔（回译）· X 跨语言阅读与表达",
  "short_name": "巴别塔（回译）",
  "version": "0.6.0",
  "description": "在 X 上翻译、查词，并用中文想法生成地道的外语回复与回译。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "sidebar/context.js",
        "sidebar/sidebar.js",
        "services/session-fields.js",
        "sidebar/sessions.js",
        "modules/reading/reading.js",
        "modules/reading/hover-lookup.js",
        "modules/reply/reply.js",
        "content.js"
      ],
      "css": [
        "sidebar/sidebar.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "巴别塔（回译）",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
